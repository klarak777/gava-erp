# Separate TEST connection; obtain routing and credentials from OpenText Task 6.
# Copy the required values into the server/container environment, then restart it.
ALDI_EDI_TEST_SFTP_ENABLED=false

# Warehouse DESADV: outbound channel is separate from the incoming ORDERS directory.
# Activate only after the partner confirms routing, staging-file handling and quantities.
GS1_COMPANY_PREFIX=5999883976
ALDI_ASN_SFTP_ENABLED=false
ALDI_ASN_LIVE_ENABLED=false
ALDI_ASN_SFTP_HOST=
ALDI_ASN_SFTP_PORT=22
ALDI_ASN_SFTP_USERNAME=
ALDI_ASN_SFTP_PASSWORD=
ALDI_ASN_SFTP_PRIVATE_KEY_PATH=
ALDI_ASN_SFTP_KEY_PASSPHRASE=
ALDI_ASN_SFTP_HOST_SHA256=
ALDI_ASN_SFTP_DIRECTORY=
ALDI_EDI_POLL_MINUTES=60
ALDI_EDI_SFTP_HOST=
ALDI_EDI_SFTP_PORT=22
ALDI_EDI_SFTP_USERNAME=
ALDI_EDI_SFTP_PASSWORD=
ALDI_EDI_SFTP_PRIVATE_KEY_PATH=
ALDI_EDI_SFTP_KEY_PASSPHRASE=
# SHA256:... fingerprint independently confirmed with OpenText.
ALDI_EDI_SFTP_HOST_SHA256=
ALDI_EDI_SFTP_DIRECTORY=
# ALDI Task 4 default is full. Use delta only if separately agreed with ALDI.
ALDI_EDI_CHANGE_MODE=full
